# Security headers for the Cloudflare-hosted frontend asset bundle
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-XSS-Protection: 1; mode=block

# CSP for HTML pages — allow inline styles, Google Fonts,
# Cloudflare Insights, GA4/GTM (gtag.js + collect beacons), and backend API for connect-src.
# script-src has no 'unsafe-inline': keep index.html free of inline executable <script> blocks
# (enforced by scripts/seo-csp-headers.test.mjs).
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://*.ociobjectstorage.ap-chuncheon-1.oci.customer-oci.com https://*.googleusercontent.com https://*.kakaocdn.net https://*.pstatic.net https://*.naver.com https://*.naver.net https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; connect-src 'self' https://api.begabaseball.xyz wss://api.begabaseball.xyz https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://*.ociobjectstorage.ap-chuncheon-1.oci.customer-oci.com https://*.googleusercontent.com https://*.kakaocdn.net https://*.pstatic.net https://*.naver.com https://*.naver.net https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; connect-src 'self' https://api.begabaseball.xyz wss://api.begabaseball.xyz https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Immutable cache for hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable
