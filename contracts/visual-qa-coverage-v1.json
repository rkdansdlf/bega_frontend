{
  "schemaVersion": 1,
  "id": "bega-visual-qa-supported-ui-v1",
  "status": "normative",
  "approvedOn": "2026-08-16",
  "owner": "frontend-platform",
  "implementation": {
    "completedStages": [
      "coverage-contract",
      "source-symbol-inventory",
      "component-render-harness"
    ],
    "pendingStages": [
      "component-state-manifests",
      "domain-scenario-coverage",
      "browser-environment-matrix",
      "ci-release-enforcement",
      "final-coverage-audit"
    ],
    "currentEnforcement": [
      "contract-schema-validation",
      "source-symbol-inventory-exact-match",
      "module-export-harness-scenario-exact-match",
      "component-state-manifest-exact-match-draft",
      "component-interaction-plan-execution-draft",
      "component-production-stylesheet-loading-draft"
    ],
    "fullGuaranteeActive": false
  },
  "guarantee": {
    "scope": "all-declared-valid-combinations",
    "statement": "Every in-scope source component symbol, every declared valid component-local state combination, and every applicable supported environment must be executed without unapproved findings.",
    "unknownPolicy": "fail",
    "sourceSymbolCompletenessRequired": true,
    "routeAuditAloneIsSufficient": false
  },
  "coverageMetrics": {
    "component_classification_coverage": {
      "numerator": "classified_component_symbols",
      "denominator": "discovered_component_symbols",
      "requiredValue": 1
    },
    "visual_registration_coverage": {
      "numerator": "registered_visual_components",
      "denominator": "classified_visual_components",
      "requiredValue": 1
    },
    "state_execution_coverage": {
      "numerator": "executed_valid_states",
      "denominator": "generated_valid_states",
      "requiredValue": 1
    },
    "environment_execution_coverage": {
      "numerator": "executed_required_environments",
      "denominator": "required_environments",
      "requiredValue": 1
    }
  },
  "sourceScope": {
    "roots": [
      "src/components",
      "src/pages"
    ],
    "extensions": [
      ".tsx"
    ],
    "candidateRule": "Every PascalCase runtime function, variable, class, wrapper, alias, and anonymous default function in an in-scope TSX file is inventoried. Non-component candidates must be explicitly classified as nonvisual.",
    "ignoredFilePatterns": [
      "**/*.test.tsx",
      "**/*.spec.tsx",
      "**/__tests__/**"
    ],
    "symbolKinds": [
      "function-declaration",
      "function-expression",
      "arrow-function",
      "class-component",
      "pascal-runtime-class",
      "pascal-runtime-value",
      "memo-wrapper",
      "forward-ref-wrapper",
      "lazy-wrapper"
    ],
    "classifications": [
      "visual",
      "behavior-only",
      "grouped-gallery",
      "nonvisual",
      "excluded"
    ],
    "unclassifiedPolicy": "fail",
    "groupedGalleryPolicy": "every-exported-symbol-must-render"
  },
