  "combinationPolicy": {
    "mode": "all-valid-component-local-combinations",
    "applicabilityRule": "Every component manifest must declare each applicable axis and every value used from that axis.",
    "componentVariantRule": "Every registered component must declare all supported component-local prop and visual variant dimensions, or provide durable evidence that none exist.",
    "cartesianRule": "All combinations across global state axes and component-local variant dimensions execute unless a machine-readable constraint proves the combination impossible or irrelevant.",
    "constraintRequirements": [
      "reason",
      "owner",
      "testEvidence"
    ],
    "scenarioCapsAllowed": false
